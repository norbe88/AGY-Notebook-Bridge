{
  "name": "agy-notebook-bridge",
  "displayName": "AGY Notebook Bridge",
  "description": "Bring Google NotebookLM into Antigravity IDE — workspace source sync, grounded research queries, and Audio Overview playback without leaving the editor.",
  "version": "0.1.0",
  "publisher": "norbe88",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "antigravity",
    "notebooklm",
    "research",
    "google",
    "notebook",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/norbe88/AGY-Notebook-Bridge.git"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ag-notebook",
          "title": "NotebookLM Research",
          "icon": "assets/notebook.svg"
        }
      ]
    },
    "views": {
      "ag-notebook": [
        {
          "type": "webview",
          "id": "ag-notebook.panel",
          "name": "Research Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "notebook-bridge.open",
        "title": "Notebook Bridge: Open Panel"
      },
      {
        "command": "notebook-bridge.syncSources",
        "title": "Notebook Bridge: Sync Sources"
      },
      {
        "command": "notebook-bridge.query",
        "title": "Notebook Bridge: Run Research Query"
      },
      {
        "command": "notebook-bridge.audioOverview",
        "title": "Notebook Bridge: Generate Audio Overview"
      },
      {
        "command": "notebook-bridge.switchNotebook",
        "title": "Notebook Bridge: Switch Active Notebook"
      },
      {
        "command": "notebook-bridge.authStatus",
        "title": "Notebook Bridge: Check Auth Status"
      },
      {
        "command": "notebook-bridge.reauthenticate",
        "title": "Notebook Bridge: Re-authenticate Session"
      },
      {
        "command": "notebook-bridge.addFileAsSource",
        "title": "Notebook Bridge: Add as NotebookLM Source"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "notebook-bridge.addFileAsSource",
          "when": "resourceExtname =~ /\\.(md|pdf|txt)$/",
          "group": "notebooklm@1"
        },
        {
          "command": "notebook-bridge.syncSources",
          "when": "explorerResourceIsFolder",
          "group": "notebooklm@2"
        }
      ]
    },
    "configuration": {
      "title": "AGY Notebook Bridge",
      "properties": {
        "notebookBridge.sourcesDir": {
          "type": "string",
          "default": "docs/notebooklm_sources",
          "description": "Workspace-relative path to sources directory synced to NotebookLM."
        },
        "notebookBridge.researchOutputDir": {
          "type": "string",
          "default": "docs/research",
          "description": "Workspace-relative path where research query results are saved."
        },
        "notebookBridge.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync sources on file change in sourcesDir."
        },
        "notebookBridge.defaultResearchMode": {
          "type": "string",
          "enum": [
            "fast",
            "deep"
          ],
          "default": "fast",
          "description": "Default research mode for queries."
        },
        "notebookBridge.activeNotebookId": {
          "type": "string",
          "default": "",
          "description": "Active Notebook ID bound to current workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run typecheck && npm run build:ext && npm run build:webview",
    "typecheck": "tsc --noEmit -p ./tsconfig.extension.json && tsc --noEmit -p ./tsconfig.webview.json",
    "build:ext": "node esbuild.extension.mjs",
    "build:webview": "node esbuild.webview.mjs",
    "watch": "node esbuild.extension.mjs --watch",
    "watch:webview": "node esbuild.webview.mjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
