{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "outDir": "out/webview-types"
  },
  "include": [
    "webview-ui/**/*.ts",
    "webview-ui/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/**",
    "out/**"
  ]
}
